# Copy to .env and fill in values.

# Postgres (Docker)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Grafana admin (UI login)
GF_SECURITY_ADMIN_USER=
GF_SECURITY_ADMIN_PASSWORD=

# Read-only DB user for Grafana datasource
GRAFANA_DB_USER=grafana_reader
GRAFANA_DB_PASSWORD=

# Open Library Search
OPENLIBRARY_BASE_URL=https://openlibrary.org/search.json
OPENLIBRARY_QUERY=has_fulltext:true
OPENLIBRARY_DEFAULT_FIELDS=key,title,author_name,has_fulltext,first_publish_year,ebook_access,ia
OPENLIBRARY_PAGE_SIZE=100
OPENLIBRARY_USER_AGENT=book-availability-streaming/0.1 (+https://github.com/lmwalk8/book-availability-streaming)
OPENLIBRARY_REQUEST_TIMEOUT=30
OPENLIBRARY_MAX_RETRIES=4
OPENLIBRARY_RETRY_BACKOFF_SEC=1.5
OPENLIBRARY_SLEEP_BETWEEN_REQUESTS_SEC=0.5

# Kafka (producer on host → localhost:9092; producer in Compose → kafka:29092)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_RAW=openlibrary.search.raw
POLL_CYCLE_SLEEP_SEC=60
OPENLIBRARY_MAX_PAGES_PER_CYCLE=10
